<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape>
            <solid android:color="@color/home_purple_light" />
            <corners android:radius="18dp" />
            <stroke android:width="1dp" android:color="@color/home_purple" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/home_surface" />
            <corners android:radius="18dp" />
            <stroke android:width="1dp" android:color="@color/home_border" />
        </shape>
    </item>
</selector>
