<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:ignore="MergeRootFrame,UseCompoundDrawables">

    <LinearLayout
        android:id="@+id/drawing_top_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="@android:color/transparent"
        android:orientation="vertical">

        <View
            android:id="@+id/drawing_status_bar_scrim"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:background="@android:color/black" />

        <LinearLayout
            android:id="@+id/drawing_header"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/bg_drawing_header"
            android:gravity="center_vertical"
            android:paddingHorizontal="20dp">

            <TextView
                android:id="@+id/back_button"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                app:drawableStartCompat="@drawable/ic_drawing_back"
                android:drawablePadding="8dp"
                android:fontFamily="sans-serif"
                android:gravity="center_vertical"
                android:text="@string/drawing_back"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/complete_button"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:background="@drawable/bg_drawing_complete_button"
                android:fontFamily="sans-serif"
                android:gravity="center"
                android:minWidth="104dp"
                android:paddingHorizontal="18dp"
                android:text="@string/complete"
                android:textColor="@android:color/white"
                android:textSize="16sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/lesson_navigator"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:background="@drawable/bg_lesson_navigator"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:visibility="gone">

            <ImageButton
                android:id="@+id/previous_step"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_lesson_previous"
                android:contentDescription="@string/previous_step"
                android:padding="10dp"
                android:src="@drawable/ic_back" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/lesson_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-rounded"
                    android:maxLines="1"
                    android:textColor="@android:color/white"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/lesson_step"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:maxLines="1"
                    android:textColor="#BFFFFFFF"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/next_step"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:background="@drawable/bg_lesson_next"
                app:drawableEndCompat="@drawable/ic_lesson_next"
                android:drawablePadding="6dp"
                android:fontFamily="sans-serif-rounded"
                android:gravity="center"
                android:minWidth="88dp"
                android:paddingHorizontal="14dp"
                android:textColor="@android:color/white"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/bottom_controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@color/home_dark_panel"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/opacity_panel"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:importantForAccessibility="no"
                android:src="@drawable/icon_eye_off" />

            <SeekBar
                android:id="@+id/opacity_slider"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginHorizontal="10dp"
                android:layout_weight="1"
                android:max="100"
                android:progress="40"
                android:progressTint="@color/home_purple"
                android:thumbTint="@android:color/white" />

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:importantForAccessibility="no"
                android:src="@drawable/icon_eye" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/options_scroll"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/option_reset"
                style="@style/DrawingOptionChip"
                android:text="@string/reset" />

            <TextView
                android:id="@+id/option_square"
                style="@style/DrawingOptionChip"
                android:text="@string/ratio_1_1" />

            <TextView
                android:id="@+id/option_portrait"
                style="@style/DrawingOptionChip"
                android:text="@string/ratio_9_16" />

            <TextView
                android:id="@+id/option_landscape"
                style="@style/DrawingOptionChip"
                android:text="@string/ratio_16_9" />

            <TextView
                android:id="@+id/option_grid_3"
                style="@style/DrawingOptionChip"
                android:text="@string/grid_3" />

            <TextView
                android:id="@+id/option_grid_4"
                style="@style/DrawingOptionChip"
                android:text="@string/grid_4" />

            <TextView
                android:id="@+id/option_grid_5"
                style="@style/DrawingOptionChip"
                android:text="@string/grid_5" />

            <TextView
                android:id="@+id/option_adjust_flip"
                style="@style/DrawingOptionChip"
                android:text="@string/flip" />

            <TextView
                android:id="@+id/option_adjust_rotate"
                style="@style/DrawingOptionChip"
                android:text="@string/rotate" />

            <TextView
                android:id="@+id/option_adjust_center"
                style="@style/DrawingOptionChip"
                android:text="@string/center" />

            <TextView
                android:id="@+id/option_adjust_reset"
                style="@style/DrawingOptionChip"
                android:text="@string/reset" />

            <TextView
                android:id="@+id/option_zoom_half"
                style="@style/DrawingOptionChip"
                android:text="@string/zoom_half" />

            <TextView
                android:id="@+id/option_zoom_one_half"
                style="@style/DrawingOptionChip"
                android:text="@string/zoom_one_half" />

            <TextView
                android:id="@+id/option_ratio_full"
                style="@style/DrawingOptionChip"
                android:text="@string/full" />

            <TextView
                android:id="@+id/option_ratio_16_9"
                style="@style/DrawingOptionChip"
                android:text="@string/ratio_16_9" />

            <TextView
                android:id="@+id/option_ratio_4_3"
                style="@style/DrawingOptionChip"
                android:text="@string/ratio_4_3" />

            <TextView
                android:id="@+id/option_ratio_square"
                style="@style/DrawingOptionChip"
                android:text="@string/ratio_1_1" />

            <TextView
                android:id="@+id/option_timer_off"
                style="@style/DrawingOptionChip"
                android:text="@string/timer_off" />

            <TextView
                android:id="@+id/option_timer_3"
                style="@style/DrawingOptionChip"
                android:text="@string/timer_3" />

            <TextView
                android:id="@+id/option_timer_10"
                style="@style/DrawingOptionChip"
                android:text="@string/timer_10" />

            <TextView
                android:id="@+id/option_switch_camera"
                style="@style/DrawingOptionChip"
                android:text="@string/front_camera" />

            <TextView
                android:id="@+id/option_camera_guide"
                style="@style/DrawingOptionChip"
                android:text="@string/guide" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/shutter_button"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/bg_shutter"
            android:contentDescription="@string/capture"
            android:padding="10dp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/quick_actions_scroll"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp">

            <TextView
                android:id="@+id/action_lock"
                style="@style/DrawingActionChip"
                android:text="@string/lock" />

            <TextView
                android:id="@+id/action_adjust"
                style="@style/DrawingActionChip"
                android:text="@string/adjust" />

            <TextView
                android:id="@+id/action_remove_bg"
                style="@style/DrawingActionChip"
                android:text="@string/remove_bg" />

            <TextView
                android:id="@+id/action_crop"
                style="@style/DrawingActionChip"
                android:text="@string/crop" />

            <TextView
                android:id="@+id/action_grid"
                style="@style/DrawingActionChip"
                android:text="@string/grid" />

            <TextView
                android:id="@+id/action_zoom"
                style="@style/DrawingActionChip"
                android:text="@string/zoom" />

            <TextView
                android:id="@+id/action_flash"
                style="@style/DrawingActionChip"
                android:text="@string/flash" />

            <TextView
                android:id="@+id/action_capture"
                style="@style/DrawingActionChip"
                android:text="@string/capture" />

            <TextView
                android:id="@+id/action_record"
                style="@style/DrawingActionChip"
                android:text="@string/record" />

            <TextView
                android:id="@+id/action_ratio"
                style="@style/DrawingActionChip"
                android:text="@string/ratio" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="74dp"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/tool_opacity"
                style="@style/DrawingTool">

                <ImageView
                    android:id="@+id/tool_opacity_icon"
                    style="@style/DrawingToolIcon"
                    android:contentDescription="@null"
                    android:src="@drawable/icon_tool_opacity_unselected" />

                <TextView
                    style="@style/DrawingToolLabel"
                    android:text="@string/opacity" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tool_canvas"
                style="@style/DrawingTool">

                <ImageView
                    android:id="@+id/tool_canvas_icon"
                    style="@style/DrawingToolIcon"
                    android:contentDescription="@null"
                    android:src="@drawable/icon_tool_canvas_unselected" />

                <TextView
                    style="@style/DrawingToolLabel"
                    android:text="@string/canvas" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tool_camera"
                style="@style/DrawingTool">

                <ImageView
                    android:id="@+id/tool_camera_icon"
                    style="@style/DrawingToolIcon"
                    android:contentDescription="@null"
                    android:src="@drawable/icon_tool_camera_unselected" />

                <TextView
                    style="@style/DrawingToolLabel"
                    android:text="@string/camera" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tool_hide"
                style="@style/DrawingTool">

                <FrameLayout
                    android:layout_width="24dp"
                    android:layout_height="24dp">

                    <ImageView
                        android:id="@+id/tool_hide_icon"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:importantForAccessibility="no"
                        android:scaleType="fitCenter"
                        android:src="@drawable/icon_tool_hide" />
                </FrameLayout>

                <TextView
                    android:id="@+id/tool_hide_label"
                    style="@style/DrawingToolLabel"
                    android:text="@string/hide" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
