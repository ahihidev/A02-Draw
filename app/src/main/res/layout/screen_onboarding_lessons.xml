<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white">

    <TextView
        android:id="@+id/page_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="@dimen/onboarding_page_title_top_margin"
        android:layout_marginEnd="16dp"
        android:fontFamily="sans-serif-rounded"
        android:gravity="center"
        android:text="@string/onboarding_lessons_title"
        android:textColor="@color/onboarding_navy"
        android:textSize="22sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/page_subtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="40dp"
        android:layout_marginTop="@dimen/onboarding_page_subtitle_top_margin"
        android:layout_marginEnd="40dp"
        android:gravity="center"
        android:lineSpacingExtra="3dp"
        android:text="@string/onboarding_lessons_subtitle"
        android:textColor="@color/onboarding_muted"
        android:textSize="15sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/page_title" />

    <ImageView
        android:id="@+id/page_artwork"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="34dp"
        android:layout_marginTop="@dimen/onboarding_page_artwork_top_margin"
        android:layout_marginEnd="34dp"
        android:layout_marginBottom="@dimen/onboarding_page_artwork_bottom_margin"
        android:adjustViewBounds="true"
        android:contentDescription="@string/onboarding_lessons_title"
        android:scaleType="fitCenter"
        android:src="@drawable/onboarding_lessons_art"
        app:layout_constraintBottom_toTopOf="@id/feature_card"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/page_subtitle" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/feature_card"
        android:layout_width="0dp"
        android:layout_height="@dimen/onboarding_feature_card_height"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="@dimen/onboarding_feature_card_button_gap"
        android:layout_marginEnd="16dp"
        app:cardBackgroundColor="@android:color/white"
        app:cardCornerRadius="18dp"
        app:cardElevation="0dp"
        app:layout_constraintBottom_toTopOf="@id/continue_button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:strokeColor="@color/onboarding_border"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="12dp">

            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter"
                android:src="@drawable/onboarding_lessons_art" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/onboarding_lessons_title"
                    android:textColor="@color/onboarding_green"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:maxLines="2"
                    android:text="@string/onboarding_lessons_feature"
                    android:textColor="@color/onboarding_muted"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <LinearLayout
        android:id="@+id/page_indicator"
        android:layout_width="wrap_content"
        android:layout_height="16dp"
        android:layout_marginBottom="@dimen/onboarding_indicator_button_gap"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintBottom_toTopOf="@id/continue_button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <View
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="@drawable/bg_onboarding_dot_inactive" />

        <View
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_onboarding_dot_inactive" />

        <View
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_onboarding_dot_active" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/continue_button"
        android:layout_width="0dp"
        android:layout_height="@dimen/onboarding_continue_button_height"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="@dimen/native_ad_action_safety_gap"
        android:elevation="8dp"
        android:text="@string/onboarding_continue"
        android:textAllCaps="false"
        android:textSize="16sp"
        android:textStyle="bold"
        app:backgroundTint="@color/onboarding_purple"
        app:cornerRadius="16dp"
        app:layout_constraintBottom_toTopOf="@id/onboarding_ad"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <com.a02.draw.ads.ui.NativeAdHostView
        android:id="@+id/onboarding_ad"
        android:layout_width="0dp"
        android:layout_height="@dimen/native_ad_large_height"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:nativeAdFormat="large" />

</androidx.constraintlayout.widget.ConstraintLayout>
