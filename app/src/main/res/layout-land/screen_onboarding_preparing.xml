<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white"
    android:padding="20dp">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/content_split"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.42" />

    <ImageView
        android:id="@+id/preparing_artwork"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:adjustViewBounds="true"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter"
        android:src="@drawable/onboarding_preparing_art"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/content_split"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/preparing_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="28dp"
        android:layout_marginEnd="20dp"
        android:fontFamily="sans-serif-rounded"
        android:gravity="center"
        android:text="@string/onboarding_preparing_title"
        android:textColor="@color/onboarding_purple"
        android:textSize="22sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@id/preparing_subtitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/content_split"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed" />

    <TextView
        android:id="@+id/preparing_subtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="28dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="20dp"
        android:gravity="center"
        android:text="@string/onboarding_preparing_subtitle"
        android:textColor="@color/onboarding_muted"
        android:textSize="14sp"
        app:layout_constraintBottom_toTopOf="@id/preparing_progress"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/content_split"
        app:layout_constraintTop_toBottomOf="@id/preparing_title" />

    <LinearLayout
        android:id="@+id/preparing_progress"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="28dp"
        android:layout_marginTop="22dp"
        android:layout_marginEnd="20dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/content_split"
        app:layout_constraintTop_toBottomOf="@id/preparing_subtitle">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/onboarding_preparing_favorites"
            android:textColor="@color/onboarding_muted"
            android:textSize="13sp" />

        <ProgressBar
            android:id="@+id/preparing_favorites_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:layout_marginTop="7dp"
            android:max="100"
            android:progress="0"
            android:progressBackgroundTint="@color/onboarding_border"
            android:progressTint="@color/onboarding_pink" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/onboarding_preparing_references"
            android:textColor="@color/onboarding_muted"
            android:textSize="13sp" />

        <ProgressBar
            android:id="@+id/preparing_references_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:layout_marginTop="7dp"
            android:max="100"
            android:progress="0"
            android:progressBackgroundTint="@color/onboarding_border"
            android:progressTint="@color/onboarding_green" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/onboarding_preparing_tools"
            android:textColor="@color/onboarding_muted"
            android:textSize="13sp" />

        <ProgressBar
            android:id="@+id/preparing_tools_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:layout_marginTop="7dp"
            android:max="100"
            android:progress="0"
            android:progressBackgroundTint="@color/onboarding_border"
            android:progressTint="@color/onboarding_purple" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
